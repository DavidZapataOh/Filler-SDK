{
  "$schema": "https://unpkg.com/@changesets/config@3.1.4/schema.json",
  "changelog": ["@changesets/changelog-github", { "repo": "filler-sdk/filler-sdk" }],
  "commit": false,
  "fixed": [["@filler-sdk/sdk", "@filler-sdk/jit-hints"]],
  "linked": [],
  "access": "public",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "ignore": [],
  "snapshot": {
    "useCalculatedVersion": true,
    "prereleaseTemplate": "{tag}-{datetime}"
  },
  "privatePackages": {
    "version": false,
    "tag": false
  }
}
