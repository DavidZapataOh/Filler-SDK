# Filler SDK dashboard — build-time env vars (Vite inlines).
# Copy to `.env.local` for dev or set in Vercel project settings for prod.
#
# All three are OPTIONAL — the dashboard renders sensibly without them
# (LiveBadge shows "offline", chart shows "no data"). For a real demo
# pointing at production indexer + solver, fill them in.

# Solver SSE — emits `event: spread-captured` payloads.
# Local dev: http://localhost:8080
# Demo (tunneled): https://<your-ngrok-id>.ngrok-free.app
# Production (Railway): https://solver.<your-domain>
VITE_SPREAD_EMITTER_URL=

# JIT-hints indexer base URL (Plan 03).
# Local dev: http://localhost:42069
# Production (Railway): https://indexer.<your-domain>
VITE_DEPTH_INDEXER_URL=

# Pool ID for the depth chart subscription (v4 PoolKey hash).
# USDC/WETH 0.05% mainnet (computed from Plan 06 SeedV4Pool):
#   poolId = keccak256(abi.encode(PoolKey{ currency0: USDC, currency1: WETH, fee: 500, tickSpacing: 10, hooks: 0x0 }))
# = 0xa7e811f49eb19b22dc3522961d4e0a1de083ed9a196aaeb64ac88e6aced755f1
VITE_DEPTH_POOL=0xa7e811f49eb19b22dc3522961d4e0a1de083ed9a196aaeb64ac88e6aced755f1
