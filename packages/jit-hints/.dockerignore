# Per-package dockerignore. Combined with the root `.dockerignore` (loaded
# from the build context root) — keep this file focused on the indexer's
# package directory.

# Build artefacts + caches.
node_modules
dist
.ponder
.next
*.log
.turbo

# Config + secrets.
.env
.env.*
!.env.example

# Tests.
test
**/*.test.ts
**/*.bench.ts
test/fixtures/tickMathVectors.json   # regenerated by `forge script`; image doesn't need it

# Editor / vcs / OS noise.
.git
.gitignore
.dockerignore
.vscode
.idea
.DS_Store

# Documentation we don't ship in the image.
README.md
CHANGELOG.md
*.md
