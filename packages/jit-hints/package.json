{
  "name": "@filler-sdk/jit-hints",
  "version": "0.0.0",
  "description": "JIT inventory hints indexer for Uniswap v4",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "abi:gen": "bun run scripts/gen-abis.ts",
    "dev": "ponder dev",
    "start": "ponder start",
    "build": "echo 'jit-hints build placeholder — bundling lands in Sprint 03 alongside SDK consumers'",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .ponder"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.1",
    "hono": "^4.12.16",
    "lru-cache": "^11.3.5",
    "pino": "^10.3.1",
    "ponder": "^0.16.6",
    "prom-client": "^15.1.3",
    "viem": "^2.48.7",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "vitest": "^4.1.5"
  }
}
