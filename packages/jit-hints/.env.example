# =============================================================================
#  @filler-sdk/jit-hints — runtime environment
# =============================================================================
# Copy this file to `.env` and fill in the values you need. Every variable here
# has a default in `src/env.ts` (Zod-validated), so you can boot the indexer
# without setting any of them — the defaults point to public RPCs + the
# canonical Uniswap v4 PoolManager addresses.
#
# In production, set `DATABASE_URL` so Ponder uses Postgres instead of the
# embedded pglite store, and provide your own RPC endpoints with rate limits
# you control.

# === HTTP API server ===
# PORT=42069
# HOST=0.0.0.0

# === Logging ===
# LOG_LEVEL=info        # trace | debug | info | warn | error | fatal

# === Database ===
# Leave unset for local pglite (.ponder/pglite). Set for production:
# DATABASE_URL=postgres://user:pass@localhost:5432/jit_hints

# === Per-chain RPC endpoints (HTTP, used for backfill) ===
# UNICHAIN_RPC_URL=https://unichain.publicnode.com
# MAINNET_RPC_URL=https://eth.publicnode.com
# BASE_RPC_URL=https://base.publicnode.com
# ARBITRUM_RPC_URL=https://arbitrum.publicnode.com
# OPTIMISM_RPC_URL=https://optimism.publicnode.com

# === Per-chain WebSocket endpoints (optional, used for live tracking) ===
# UNICHAIN_WSS_URL=wss://unichain-rpc.publicnode.com
# MAINNET_WSS_URL=wss://ethereum-rpc.publicnode.com
# BASE_WSS_URL=wss://base-rpc.publicnode.com
# ARBITRUM_WSS_URL=wss://arbitrum-one-rpc.publicnode.com
# OPTIMISM_WSS_URL=wss://optimism-rpc.publicnode.com

# === Per-chain v4 PoolManager addresses ===
# Defaults are the canonical Uniswap deployments — only override if you're
# running against a fork or a non-canonical deployment.
# UNICHAIN_POOL_MANAGER=0x1f98400000000000000000000000000000000004
# MAINNET_POOL_MANAGER=0x000000000004444c5dc75cb358380d2e3de08a90
# BASE_POOL_MANAGER=0x498581ff718922c3f8e6a244956af099b2652b2b
# ARBITRUM_POOL_MANAGER=0x360e68faccca8ca4f01a01ea7b8538def68d2bd1
# OPTIMISM_POOL_MANAGER=0x9a13f98cb987694c9f086b1f5eb990eea8264ec3

# === Per-chain start blocks ===
# Set to the v4 PoolManager deployment block on each chain to skip backfill.
# Leaving at 0 makes Ponder backfill from genesis (slow + expensive on mainnet).
# UNICHAIN_START_BLOCK=0
# MAINNET_START_BLOCK=21000000
# BASE_START_BLOCK=23000000
# ARBITRUM_START_BLOCK=290000000
# OPTIMISM_START_BLOCK=128000000
