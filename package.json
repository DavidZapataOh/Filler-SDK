{
  "name": "filler-sdk-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Filler SDK — deploy vertical UniswapX solvers in npm install",
  "license": "MIT",
  "homepage": "https://filler-sdk.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/filler-sdk/filler-sdk.git"
  },
  "workspaces": ["packages/*", "examples/*", "apps/*"],
  "scripts": {
    "build": "bun run --filter '*' build",
    "build:contracts": "cd contracts && forge build",
    "build:contracts:sizes": "cd contracts && forge build --sizes",
    "test": "bun run --filter '*' test",
    "test:contracts": "cd contracts && forge test",
    "test:contracts:ci": "cd contracts && FOUNDRY_PROFILE=ci forge test",
    "test:contracts:deep": "cd contracts && FOUNDRY_PROFILE=deep forge test",
    "coverage:contracts": "cd contracts && forge coverage --report summary --report lcov",
    "snapshot:contracts": "cd contracts && forge snapshot",
    "snapshot:contracts:check": "cd contracts && forge snapshot --check",
    "fmt:contracts": "cd contracts && forge fmt",
    "fmt:contracts:check": "cd contracts && forge fmt --check",
    "slither": "cd contracts && slither . --config-file slither.config.json",
    "lint": "biome check . && tsc --noEmit -p tsconfig.json",
    "format": "biome format --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "clean": "bun run --filter '*' clean && rm -rf node_modules",
    "clean:contracts": "cd contracts && rm -rf out cache .gas-snapshot",
    "validate:contracts": "bash contracts/scripts/validate-setup.sh",
    "changeset": "changeset",
    "changeset:status": "changeset status --verbose",
    "version": "changeset version && bun install --lockfile-only",
    "release": "bun run build && changeset publish",
    "release:snapshot": "changeset version --snapshot canary && bun run build && changeset publish --tag canary"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.27.10",
    "@changesets/changelog-github": "^0.5.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.1.30"
  },
  "packageManager": "bun@1.1.30"
}
